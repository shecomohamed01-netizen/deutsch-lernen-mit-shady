rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net - Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'currentLevel'])
        && data.uid == request.auth.uid
        && data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 256
        && data.currentLevel in ['A1', 'A2', 'B1', 'B2']
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('masteredCount' in data) || data.masteredCount is int)
        && (!('completedHomeworkCount' in data) || data.completedHomeworkCount is int);
    }

    function isValidUserProgress(data) {
      return data.keys().hasAll(['userId', 'masteredWordIds', 'currentLevel'])
        && data.userId == request.auth.uid
        && data.currentLevel in ['A1', 'A2', 'B1', 'B2']
        && data.masteredWordIds is list
        && data.masteredWordIds.size() <= 500;
    }

    function isValidHomeworkSubmission(data) {
      return data.keys().hasAll(['id', 'userId', 'level', 'score', 'totalQuestions', 'percentage'])
        && data.userId == request.auth.uid
        && data.level in ['A1', 'A2', 'B1', 'B2']
        && data.score is int
        && data.totalQuestions is int
        && data.percentage is int;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming())
        && incoming().uid == existing().uid;
      allow delete: if isOwner(userId) && isValidId(userId);

      match /progress/{progressId} {
        allow read: if isOwner(userId) && isValidId(userId);
        allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(progressId) && isValidUserProgress(incoming());
        allow delete: if isOwner(userId) && isValidId(userId);
      }

      match /homework_submissions/{submissionId} {
        allow list, get: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(submissionId) && isValidHomeworkSubmission(incoming());
        allow update, delete: if isOwner(userId) && isValidId(userId);
      }
    }
  }
}
